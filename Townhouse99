<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ZATYSHOK — Апартаменти подобово в Петропавлівській Борщагівці</title>
<meta name="description" content="Затишні апартаменти подобово в Петропавлівській Борщагівці, Київська область. 5 квартир для комфортного проживання.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#faf8f5;
    --bg-alt:#f2ede6;
    --ink:#20211f;
    --ink-soft:#5c5b56;
    --line:#e4ddd2;
    --accent:#b5693f;
    --accent-soft:#e9dccb;
    --white:#ffffff;
    --radius:18px;
    --shadow:0 10px 30px rgba(32,33,31,0.06);
    --shadow-lg:0 20px 50px rgba(32,33,31,0.12);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
    background:var(--bg);
    color:var(--ink);
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  .container{max-width:1180px;margin:0 auto;padding:0 28px;}
  section{padding:96px 0;}
  h1,h2,h3{font-weight:700;letter-spacing:-0.02em;}
  .eyebrow{
    text-transform:uppercase;
    letter-spacing:0.14em;
    font-size:12px;
    font-weight:700;
    color:var(--accent);
    margin-bottom:14px;
  }

  /* Header */
  header{
    position:sticky;top:0;z-index:100;
    background:rgba(250,248,245,0.85);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav{
    display:flex;align-items:center;justify-content:space-between;
    padding:20px 28px;max-width:1180px;margin:0 auto;
  }
  .logo{font-size:20px;font-weight:800;letter-spacing:-0.01em;}
  .logo span{color:var(--accent);}
  .nav-links{display:flex;gap:36px;font-size:15px;font-weight:500;}
  .nav-links a{color:var(--ink-soft);transition:color .2s;}
  .nav-links a:hover{color:var(--ink);}
  .nav-cta{
    display:flex;align-items:center;gap:18px;
  }
  .btn{
    display:inline-flex;align-items:center;justify-content:center;
    padding:12px 24px;
    border-radius:999px;
    font-weight:600;font-size:14px;
    border:1px solid transparent;
    cursor:pointer;
    transition:transform .15s ease, box-shadow .2s ease, background .2s ease;
    white-space:nowrap;
  }
  .btn-primary{background:var(--ink);color:var(--white);}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:var(--shadow);}
  .btn-outline{background:transparent;border:1px solid var(--ink);color:var(--ink);}
  .btn-outline:hover{background:var(--ink);color:var(--white);}
  .menu-toggle{display:none;background:none;border:none;font-size:24px;cursor:pointer;}

  /* Hero */
  .hero{
    padding:90px 0 60px;
    display:grid;
    grid-template-columns:1.1fr 1fr;
    gap:60px;
    align-items:center;
  }
  .hero h1{font-size:clamp(34px, 4.4vw, 56px);line-height:1.08;margin-bottom:22px;}
  .hero p{font-size:18px;color:var(--ink-soft);max-width:480px;margin-bottom:32px;}
  .hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:36px;}
  .hero-stats{display:flex;gap:36px;}
  .hero-stats div{display:flex;flex-direction:column;}
  .hero-stats b{font-size:26px;font-weight:800;}
  .hero-stats span{font-size:13px;color:var(--ink-soft);}
  .hero-visual{
    position:relative;
    aspect-ratio:4/5;
    border-radius:var(--radius);
    overflow:hidden;
    box-shadow:var(--shadow-lg);
  }
  .ph{
    width:100%;height:100%;
    display:flex;align-items:center;justify-content:center;
    background:linear-gradient(135deg,#e7d9c6,#c9ab86 55%,#a9835b);
    color:rgba(255,255,255,0.85);
    font-size:14px;font-weight:600;letter-spacing:0.04em;
    text-align:center;
    position:relative;
  }
  .ph::after{
    content:'📷 ЗАМІНІТЬ НА ФОТО';
    position:absolute;bottom:16px;left:16px;right:16px;
    background:rgba(0,0,0,0.35);
    padding:8px 12px;border-radius:10px;
    font-size:11px;
  }
  .ph-alt{background:linear-gradient(135deg,#d8c9b4,#b79b78 55%,#8f6c47);}
  .ph-alt2{background:linear-gradient(135deg,#e3d3ba,#c2a37a 55%,#9c7749);}
  .ph-alt3{background:linear-gradient(135deg,#ded0ba,#bd9d76 55%,#987447);}
  .ph-alt4{background:linear-gradient(135deg,#e9dcc6,#cbae87 55%,#a2814f);}

  /* Trust bar */
  .trust{
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
    padding:32px 0;
  }
  .trust .container{
    display:flex;justify-content:space-between;flex-wrap:wrap;gap:24px;
    color:var(--ink-soft);font-size:14px;font-weight:600;
  }

  /* Apartments */
  .section-head{
    display:flex;justify-content:space-between;align-items:flex-end;
    margin-bottom:44px;gap:24px;flex-wrap:wrap;
  }
  .section-head h2{font-size:clamp(28px,3vw,38px);}
  .section-head p{color:var(--ink-soft);max-width:420px;font-size:15px;}

  .apt-grid{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:28px;
  }
  .apt-card{
    background:var(--white);
    border-radius:var(--radius);
    overflow:hidden;
    box-shadow:var(--shadow);
    transition:transform .25s ease, box-shadow .25s ease;
    cursor:pointer;
    display:flex;flex-direction:column;
  }
  .apt-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg);}
  .apt-card .ph{aspect-ratio:4/3;font-size:12px;}
  .apt-body{padding:22px 22px 26px;flex:1;display:flex;flex-direction:column;}
  .apt-body h3{font-size:19px;margin-bottom:6px;}
  .apt-meta{display:flex;gap:14px;color:var(--ink-soft);font-size:13px;margin-bottom:14px;flex-wrap:wrap;}
  .apt-desc{color:var(--ink-soft);font-size:14px;margin-bottom:18px;flex:1;}
  .apt-foot{display:flex;justify-content:space-between;align-items:center;}
  .price{font-size:18px;font-weight:800;}
  .price span{font-size:12px;font-weight:500;color:var(--ink-soft);}
  .apt-link{font-size:13px;font-weight:700;color:var(--accent);}

  /* Why us */
  .why-grid{
    display:grid;grid-template-columns:repeat(4,1fr);gap:24px;
  }
  .why-card{
    background:var(--bg-alt);
    border-radius:var(--radius);
    padding:28px 24px;
  }
  .why-icon{font-size:26px;margin-bottom:16px;}
  .why-card h3{font-size:16px;margin-bottom:8px;}
  .why-card p{font-size:13px;color:var(--ink-soft);}

  /* About */
  .about{
    display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;
  }
  .about-text p{color:var(--ink-soft);margin-bottom:16px;font-size:16px;}
  .about-visual{aspect-ratio:1/1;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-lg);}

  /* CTA band */
  .cta-band{
    background:var(--ink);
    color:var(--white);
    border-radius:24px;
    padding:64px 48px;
    text-align:center;
    margin:0 28px;
  }
  .cta-band h2{font-size:clamp(26px,3.4vw,38px);margin-bottom:14px;}
  .cta-band p{color:rgba(255,255,255,0.65);margin-bottom:30px;font-size:16px;}
  .cta-band .btn-primary{background:var(--white);color:var(--ink);}
  .cta-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;}
  .cta-band .btn-outline{border-color:rgba(255,255,255,0.4);color:var(--white);}
  .cta-band .btn-outline:hover{background:var(--white);color:var(--ink);}

  /* Contact */
  .contact-grid{
    display:grid;grid-template-columns:1fr 1fr;gap:60px;
  }
  .contact-list{list-style:none;margin-top:28px;}
  .contact-list li{
    display:flex;gap:16px;padding:16px 0;border-top:1px solid var(--line);
    font-size:15px;
  }
  .contact-list li:last-child{border-bottom:1px solid var(--line);}
  .contact-list b{min-width:120px;color:var(--ink-soft);font-weight:600;font-size:13px;text-transform:uppercase;letter-spacing:0.04em;}
  .map-ph{
    aspect-ratio:1/1;border-radius:var(--radius);
    background:repeating-linear-gradient(45deg, #efe8db, #efe8db 12px, #e6dcc8 12px, #e6dcc8 24px);
    display:flex;align-items:center;justify-content:center;
    color:var(--ink-soft);font-weight:600;font-size:14px;text-align:center;padding:20px;
  }

  /* Footer */
  footer{border-top:1px solid var(--line);padding:44px 0;}
  .footer-inner{
    display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;
    color:var(--ink-soft);font-size:13px;
  }
  .footer-links{display:flex;gap:22px;}

  /* Modal */
  .modal-overlay{
    position:fixed;inset:0;background:rgba(20,19,17,0.55);
    display:none;align-items:center;justify-content:center;
    z-index:1000;padding:24px;
  }
  .modal-overlay.open{display:flex;}
  .modal{
    background:var(--white);
    border-radius:22px;
    max-width:880px;width:100%;
    max-height:88vh;overflow-y:auto;
    box-shadow:var(--shadow-lg);
    position:relative;
  }
  .modal-close{
    position:absolute;top:18px;right:18px;
    width:38px;height:38px;border-radius:50%;
    background:var(--white);border:1px solid var(--line);
    font-size:18px;cursor:pointer;z-index:2;
    display:flex;align-items:center;justify-content:center;
  }
  .modal-gallery{
    display:grid;grid-template-columns:1.4fr 1fr;gap:8px;
    height:320px;
  }
  .modal-gallery .ph:first-child{grid-row:span 2;}
  .modal-gallery .ph{aspect-ratio:auto;font-size:11px;border-radius:0;}
  .modal-body{padding:32px 36px 40px;}
  .modal-body h3{font-size:26px;margin-bottom:8px;}
  .modal-meta{display:flex;gap:18px;color:var(--ink-soft);font-size:14px;margin-bottom:20px;flex-wrap:wrap;}
  .modal-body p{color:var(--ink-soft);margin-bottom:20px;}
  .amenities-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:28px;}
  .amenity{display:flex;gap:8px;align-items:center;font-size:14px;color:var(--ink);}
  .modal-actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center;}
  .modal-price{font-size:22px;font-weight:800;margin-right:auto;}
  .modal-price span{display:block;font-size:12px;font-weight:500;color:var(--ink-soft);}

  @media (max-width:960px){
    .hero{grid-template-columns:1fr;}
    .hero-visual{order:-1;aspect-ratio:16/10;}
    .apt-grid{grid-template-columns:repeat(2,1fr);}
    .why-grid{grid-template-columns:repeat(2,1fr);}
    .about{grid-template-columns:1fr;}
    .contact-grid{grid-template-columns:1fr;}
    .nav-links{display:none;}
    .modal-gallery{grid-template-columns:1fr;height:auto;}
    .modal-gallery .ph{aspect-ratio:16/10;}
    .modal-gallery .ph:first-child{grid-row:auto;}
  }
  @media (max-width:600px){
    section{padding:64px 0;}
    .apt-grid{grid-template-columns:1fr;}
    .why-grid{grid-template-columns:1fr;}
    .cta-band{padding:44px 24px;margin:0 16px;}
    .nav-cta .btn-outline{display:none;}
  }
</style>
</head>
