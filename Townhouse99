const grid = document.getElementById('aptGrid');
grid.innerHTML = apartments.map(a => `
  <div class="apt-card" data-id="${a.id}">
    <div class="${a.photoClass}">Фото — ${a.name}</div>
    <div class="apt-body">
      <h3>${a.name}</h3>
      <div class="apt-meta">
        <span>${a.rooms}</span>
        <span>·</span>
        <span>${a.area}</span>
        <span>·</span>
        <span>${a.guests}</span>
      </div>
      <p class="apt-desc">${a.desc}</p>
      <div class="apt-foot">
        <div class="price">${a.price} ₴ <span>/ доба</span></div>
        <span class="apt-link">Детальніше →</span>
      </div>
    </div>
  </div>
`).join('');

const overlay = document.getElementById('modalOverlay');
const modalContent = document.getElementById('modalContent');

function openModal(id){
  const a = apartments.find(x => x.id === id);
  modalContent.innerHTML = `
    <div class="modal-gallery">
      <div class="${a.photoClass}">Фото 1</div>
      <div class="${a.photoClass}">Фото 2</div>
      <div class="${a.photoClass}">Фото 3</div>
    </div>
    <div class="modal-body">
      <h3>${a.name}</h3>
      <div class="modal-meta">
        <span>${a.rooms}</span>
        <span>${a.area}</span>
        <span>${a.guests}</span>
      </div>
      <p>${a.fullDesc}</p>
      <div class="amenities-grid">
        ${a.amenities.map(am => `<div class="amenity">✓ ${am}</div>`).join('')}
      </div>
      <div class="modal-actions">
        <div class="modal-price">${a.price} ₴ <span>за добу</span></div>
        <a href="https://t.me/your_telegram?text=Вітаю! Хочу забронювати ${encodeURIComponent(a.name)}" class="btn btn-primary" target="_blank" rel="noopener">Забронювати в Telegram</a>
        <a href="tel:+380000000000" class="btn btn-outline">Зателефонувати</a>
      </div>
    </div>
  `;
  overlay.classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeModal(){
  overlay.classList.remove('open');
  document.body.style.overflow = '';
}

grid.addEventListener('click', e => {
  const card = e.target.closest('.apt-card');
  if(card) openModal(Number(card.dataset.id));
});
document.getElementById('modalClose').addEventListener('click', closeModal);
overlay.addEventListener('click', e => { if(e.target === overlay) closeModal(); });
document.addEventListener('keydown', e => { if(e.key === 'Escape') closeModal(); });
</script>

